---
interface Props {
  lang: 'en' | 'de';
}

const { lang } = Astro.props;
const isDe = lang === 'de';

const copy = isDe
  ? {
      subject: 'Neue Räucherkugel-Anfrage von naturalincense.de',
      name: 'Name',
      email: 'E-Mail',
      formula: 'Welche Rezeptur interessiert dich?',
      quantity: 'Wie viele 10-g-Packungen interessieren dich?',
      country: 'Land oder Region',
      message: 'Möchtest du uns noch etwas mitteilen?',
      messagePlaceholder: 'Zum Beispiel: Duftvorlieben, vorhandene Duftlampe oder eine Frage.',
      chooseFormula: 'Bitte auswählen',
      unsure: 'Noch nicht sicher',
      quantityOne: '1 Packung',
      quantityFew: '2–3 Packungen',
      quantityMany: '4 oder mehr Packungen',
      send: 'Anfrage senden',
      sending: 'Wird gesendet…',
      success: 'Vielen Dank! Deine Anfrage wurde gesendet. Wir melden uns mit Verfügbarkeit und den nächsten Schritten.',
      error: 'Etwas ist schiefgelaufen. Bitte versuche es erneut oder schreibe direkt an hello@naturalincense.de.',
      privacy: 'Mit dem Absenden nutzt du deine Angaben ausschließlich für diese Anfrage. Details findest du in unserer',
      privacyLink: 'Datenschutzerklärung',
      direct: 'Du möchtest lieber direkt schreiben?',
      formulaOptions: [
        '青麟髓 · Qing Lin Sui',
        '春月蝴蝶香 · Spring Moon Butterfly',
        '汉建宁宫中香 · Han Jianning Palace Incense',
        '旷野幽兰 · Wild Orchid of the Wilderness',
        '寿阳公主梅花香 · Princess Shouyang Plum Blossom',
        '荀令十里香 · Xun Ling’s Ten-Mile Fragrance',
        '莉莉玛莲 · Lili Marleen',
      ],
      privacyHref: '/de/privacy/',
    }
  : {
      subject: 'New incense pellet inquiry from naturalincense.de',
      name: 'Name',
      email: 'Email',
      formula: 'Which formula interests you?',
      quantity: 'How many 10 g packs are you considering?',
      country: 'Country or region',
      message: 'Anything you would like us to know?',
      messagePlaceholder: 'For example: scent preferences, the warmer you use, or a question.',
      chooseFormula: 'Please select',
      unsure: 'Not sure yet',
      quantityOne: '1 pack',
      quantityFew: '2–3 packs',
      quantityMany: '4 or more packs',
      send: 'Send inquiry',
      sending: 'Sending…',
      success: 'Thank you — your inquiry has been sent. We will reply with availability and next steps.',
      error: 'Something went wrong. Please try again or write directly to hello@naturalincense.de.',
      privacy: 'By submitting, you allow us to use these details only to respond to this inquiry. Read our',
      privacyLink: 'Privacy Policy',
      direct: 'Prefer to write directly?',
      formulaOptions: [
        '青麟髓 · Qing Lin Sui',
        '春月蝴蝶香 · Spring Moon Butterfly',
        '汉建宁宫中香 · Han Jianning Palace Incense',
        '旷野幽兰 · Wild Orchid of the Wilderness',
        '寿阳公主梅花香 · Princess Shouyang Plum Blossom',
        '荀令十里香 · Xun Ling’s Ten-Mile Fragrance',
        '莉莉玛莲 · Lili Marleen',
      ],
      privacyHref: '/privacy/',
    };
---

<form class="inquiry-form" data-inquiry-form action="https://formsubmit.co/hello@naturalincense.de" method="POST" novalidate>
  <input type="hidden" name="_subject" value={copy.subject} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="inquiry_type" value="incense_pellets" />
  <input type="hidden" name="inquiry_language" value={lang} />
  <input type="hidden" name="inquiry_source" value="direct" data-source />
  <input type="hidden" name="landing_url" value="" data-landing-url />
  <input type="hidden" name="referrer" value="" data-referrer />
  <input type="hidden" name="utm_source" value="" data-utm-source />
  <input type="hidden" name="utm_medium" value="" data-utm-medium />
  <input type="hidden" name="utm_campaign" value="" data-utm-campaign />
  <input type="hidden" name="utm_term" value="" data-utm-term />
  <input type="hidden" name="utm_content" value="" data-utm-content />
  <input type="text" name="_honey" class="inquiry-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="inquiry-form__field">
    <label for="inquiry-name">{copy.name}</label>
    <input id="inquiry-name" type="text" name="name" required autocomplete="name" />
  </div>

  <div class="inquiry-form__field">
    <label for="inquiry-email">{copy.email}</label>
    <input id="inquiry-email" type="email" name="email" required autocomplete="email" />
  </div>

  <div class="inquiry-form__field">
    <label for="inquiry-formula">{copy.formula}</label>
    <select id="inquiry-formula" name="formula_interest" required>
      <option value="" selected disabled>{copy.chooseFormula}</option>
      {copy.formulaOptions.map((formula) => <option value={formula}>{formula}</option>)}
      <option value={copy.unsure}>{copy.unsure}</option>
    </select>
  </div>

  <div class="inquiry-form__field">
    <label for="inquiry-quantity">{copy.quantity}</label>
    <select id="inquiry-quantity" name="quantity_interest" required>
      <option value="" selected disabled>{copy.chooseFormula}</option>
      <option value={copy.quantityOne}>{copy.quantityOne}</option>
      <option value={copy.quantityFew}>{copy.quantityFew}</option>
      <option value={copy.quantityMany}>{copy.quantityMany}</option>
      <option value={copy.unsure}>{copy.unsure}</option>
    </select>
  </div>

  <div class="inquiry-form__field">
    <label for="inquiry-country">{copy.country}</label>
    <input id="inquiry-country" type="text" name="country_region" required autocomplete="country-name" />
  </div>

  <div class="inquiry-form__field">
    <label for="inquiry-message">{copy.message}</label>
    <textarea id="inquiry-message" name="message" rows="5" placeholder={copy.messagePlaceholder}></textarea>
  </div>

  <p class="inquiry-form__privacy">{copy.privacy} <a href={copy.privacyHref}>{copy.privacyLink}</a>.</p>
  <button class="inquiry-form__submit" type="submit" data-submit>{copy.send}</button>
  <p class="inquiry-form__status" data-status role="status" aria-live="polite"></p>
</form>
<p class="inquiry-form__direct">{copy.direct} <a href="mailto:hello@naturalincense.de">hello@naturalincense.de</a></p>

<script define:vars={{ copy }}>
  const form = document.querySelector('[data-inquiry-form]');

  if (form instanceof HTMLFormElement) {
    const params = new URLSearchParams(window.location.search);
    const setValue = (selector, value) => {
      const field = form.querySelector(selector);
      if (field instanceof HTMLInputElement && value) field.value = value;
    };

    setValue('[data-source]', params.get('source') || 'direct');
    setValue('[data-landing-url]', window.location.href);
    setValue('[data-referrer]', document.referrer);
    ['source', 'medium', 'campaign', 'term', 'content'].forEach((key) => {
      setValue(`[data-utm-${key}]`, params.get(`utm_${key}`) || '');
    });

    const formula = params.get('formula');
    const formulaField = form.querySelector('#inquiry-formula');
    if (formula && formulaField instanceof HTMLSelectElement) {
      const match = Array.from(formulaField.options).find((option) => option.value === formula);
      if (match) formulaField.value = match.value;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-status]');
      const submit = form.querySelector('[data-submit]');

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (status instanceof HTMLElement) {
        status.textContent = copy.sending;
        status.className = 'inquiry-form__status is-sending';
      }
      if (submit instanceof HTMLButtonElement) submit.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Inquiry submission failed');

        if (status instanceof HTMLElement) {
          status.textContent = copy.success;
          status.className = 'inquiry-form__status is-success';
        }
        form.reset();
        setValue('[data-source]', params.get('source') || 'direct');
        setValue('[data-landing-url]', window.location.href);
        setValue('[data-referrer]', document.referrer);
        ['source', 'medium', 'campaign', 'term', 'content'].forEach((key) => {
          setValue(`[data-utm-${key}]`, params.get(`utm_${key}`) || '');
        });
      } catch {
        if (status instanceof HTMLElement) {
          status.textContent = copy.error;
          status.className = 'inquiry-form__status is-error';
        }
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  }
</script>

<style>
  .inquiry-form { display: grid; gap: 18px; text-align: left; }
  .inquiry-form__field { display: grid; gap: 7px; }
  .inquiry-form__field label { color: var(--color-text-secondary); font-size: 13px; font-weight: 500; letter-spacing: 0.02em; }
  .inquiry-form__field input, .inquiry-form__field select, .inquiry-form__field textarea { box-sizing: border-box; width: 100%; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-subtle); color: var(--color-text); font-family: var(--font-sans); font-size: 15px; line-height: 1.5; padding: 12px 14px; }
  .inquiry-form__field textarea { min-height: 120px; resize: vertical; }
  .inquiry-form__field input:focus, .inquiry-form__field select:focus, .inquiry-form__field textarea:focus { border-color: var(--color-accent); box-shadow: 0 0 0 3px var(--color-accent-subtle); outline: none; }
  .inquiry-form__honeypot { display: none; }
  .inquiry-form__privacy, .inquiry-form__direct { color: var(--color-text-tertiary); font-size: 12px; line-height: 1.55; margin: 0; }
  .inquiry-form__privacy a, .inquiry-form__direct a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
  .inquiry-form__submit { background: var(--color-accent); border: 0; border-radius: var(--radius-md); color: #fff; cursor: pointer; font-family: var(--font-sans); font-size: 15px; font-weight: 500; padding: 14px 24px; transition: background 0.2s ease, transform 0.2s ease; width: 100%; }
  .inquiry-form__submit:hover:not(:disabled) { background: var(--color-accent-hover); transform: translateY(-1px); }
  .inquiry-form__submit:disabled { cursor: wait; opacity: 0.7; }
  .inquiry-form__status { font-size: 13px; line-height: 1.5; margin: -4px 0 0; min-height: 1.5em; }
  .inquiry-form__status.is-sending { color: var(--color-text-secondary); }
  .inquiry-form__status.is-success { color: var(--color-forest); }
  .inquiry-form__status.is-error { color: #b3261e; }
</style>
