---
import { SITE_TITLE } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

const url = new URL(Astro.url.pathname, Astro.site);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const navItems = [
  { href: lang === "de" ? "/de/" : "/", label: t("nav.home") },
  { href: lang === "de" ? "/de/xiang-wan/" : "/xiang-wan/", label: t("nav.pellets") },
  { href: lang === "de" ? "/de/blog/" : "/blog/", label: t("nav.journal") },
  { href: lang === "de" ? "/de/materials/" : "/materials/", label: t("nav.materials") },
  { href: lang === "de" ? "/de/about/" : "/about/", label: t("nav.about") },
  { href: lang === "de" ? "/de/contact/" : "/contact/", label: t("nav.contact") },
];
---

<header class="header">
  <nav class="container header__nav" aria-label="Primary navigation">
    <a href={lang === "de" ? "/de/" : "/"} class="header__logo">
      <span class="header__logo-text">{SITE_TITLE}</span>
    </a>
    <ul class="header__links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="header__link">{item.label}</a>
        </li>
      ))}
      <li class="header__language">
        <LanguageSwitcher currentPath={Astro.url.pathname} />
      </li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
  }

  .header__logo {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1;
    text-decoration: none;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .header__link {
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 460;
    text-decoration: none;
  }

  .header__link:hover {
    color: var(--color-text);
  }

  .header__language {
    padding-left: 4px;
    border-left: 1px solid var(--color-border);
  }

  @media (max-width: 860px) {
    .header__links {
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .header__nav {
      min-height: 56px;
    }

    .header__links {
      gap: 10px;
    }

    .header__links li:nth-child(4),
    .header__links li:nth-child(5) {
      display: none;
    }

    .header__link {
      font-size: 11px;
    }

    .header__logo {
      font-size: 12px;
    }
  }
</style>
