---
import { SITE_TITLE } from '../consts';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <span class="footer__logo">{SITE_TITLE}</span>
        <p class="footer__tagline">
          Exploring the art, history, and materials of Chinese incense culture — from precious agarwood to ancient blending traditions.
        </p>
      </div>
      <div class="footer__col">
        <h4 class="footer__heading">Explore</h4>
        <nav class="footer__nav">
          <a href="/blog">Journal</a>
          <a href="/materials">Materials</a>
          <a href="/tags">Topics</a>
          <a href="/about">About</a>
        </nav>
      </div>
      <div class="footer__col">
        <h4 class="footer__heading">Connect</h4>
        <nav class="footer__nav">
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="mailto:hello@naturalincense.de">hello@naturalincense.de</a>
        </nav>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {new Date().getFullYear()} {SITE_TITLE}. All rights reserved.
      </p>
      <p class="footer__crafted">Hand rolled with intention</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 64px 0 32px;
    margin-top: 80px;
    background: var(--color-surface-subtle);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 40px;
  }

  .footer__logo {
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--color-text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer__tagline {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin-top: 12px;
    max-width: 38ch;
    line-height: 1.6;
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: 14px;
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__nav a {
    font-size: 13px;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__nav a:hover {
    color: var(--color-accent);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .footer__copyright {
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .footer__crafted {
    font-family: var(--font-serif);
    font-size: 13px;
    font-style: italic;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .footer__bottom {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }
</style>
