---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagChip from '../components/TagChip.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getLangFromUrl } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & {
  related?: CollectionEntry<'blog'>[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, related = [] } = Astro.props;
const postURL = new URL(Astro.url.pathname, Astro.site);
const heroURL = heroImage ? new URL(heroImage, Astro.site) : null;
const lang = getLangFromUrl(Astro.url);
const isDe = lang === "de";
const homeHref = isDe ? "/de/" : "/";
const journalHref = isDe ? "/de/blog/" : "/blog/";
const homeLabel = isDe ? "Start" : "Home";
const journalLabel = "Journal";

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  image: heroURL?.toString(),
  mainEntityOfPage: postURL.toString(),
  author: { '@type': 'Organization', name: 'naturalincense.de', url: new URL('/', Astro.site).toString() },
  publisher: { '@type': 'Organization', name: 'naturalincense.de', url: new URL('/', Astro.site).toString() },
  inLanguage: lang,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: new URL(homeHref, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: journalLabel, item: new URL(journalHref, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: postURL.toString() },
  ],
};
---

<BaseLayout title={`${title} — INCENSE`} description={description} ogImage={heroURL?.toString()}>
  <div class="post__breadcrumb">
    <Breadcrumb crumbs={[{ label: homeLabel, href: homeHref }, { label: journalLabel, href: journalHref }, { label: title }]} />
  </div>

  <article class="post">
    {heroImage && (
      <figure class="post__hero">
        <img src={heroImage} alt={title} />
      </figure>
    )}

    <header class="post__header">
      <div class="post__meta">
        <time class="post__date"><FormattedDate date={pubDate} /></time>
        {updatedDate && <span class="post__updated">Updated <FormattedDate date={updatedDate} /></span>}
      </div>
      <h1 class="post__title">{title}</h1>
      {description && <p class="post__desc">{description}</p>}
      {tags && tags.length > 0 && (
        <div class="post__tags" aria-label="Article tags">
          {tags.map((tag) => <TagChip tag={tag} />)}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  {related.length > 0 && (
    <section class="related-posts" aria-labelledby="related-title">
      <div class="container related-posts__inner">
        <p class="related-posts__label">{isDe ? "Aus dem Journal" : "From the journal"}</p>
        <h2 id="related-title">{isDe ? "Weiterlesen" : "Continue reading"}</h2>
        <div class="related-posts__list">
          {related.map((item) => (
            <article class="related-posts__item">
              <h3><a href={`${journalHref}${item.id}/`}>{item.data.title}</a></h3>
              {item.data.description && <p>{item.data.description}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>

<style>
  .post__breadcrumb { max-width: calc(var(--content-width) + 48px); margin: 0 auto; padding: 18px 24px 0; }
  .post { max-width: var(--content-width); margin: 0 auto; padding: 0 24px; }
  .post__hero { margin: 28px 0 42px; overflow: hidden; border: 1px solid var(--color-border); }
  .post__hero img { aspect-ratio: 16 / 9; object-fit: cover; }
  .post__header { margin-bottom: 42px; }
  .post__meta { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .post__date, .post__updated { color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; }
  .post__title { margin-bottom: 14px; font-size: clamp(1.9rem, 4.2vw, 3rem); letter-spacing: -0.025em; }
  .post__desc { font-size: 15px; line-height: 1.65; }
  .post__tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .prose { padding-bottom: 76px; color: var(--color-text); font-size: 16px; line-height: 1.8; }
  .prose p { max-width: none; margin-bottom: 1.45em; color: var(--color-text); }
  .prose h2 { margin: 2.1em 0 0.75em; font-size: 1.55rem; }
  .prose h3 { margin: 1.55em 0 0.55em; font-size: 1.2rem; }
  .prose a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.18em; }
  .prose img { margin: 2em auto; border: 1px solid var(--color-border); }
  .prose blockquote { margin: 2em 0; padding-left: 18px; border-left: 2px solid var(--color-accent); color: var(--color-text-secondary); font-style: italic; }
  .prose blockquote p { color: inherit; }
  .prose hr { margin: 2.2em 0; border: 0; border-top: 1px solid var(--color-border); }
  .prose code { padding: 2px 5px; border-radius: var(--radius-sm); background: var(--color-surface-subtle); font-family: var(--font-mono); font-size: 13px; }
  .prose pre { margin: 1.5em 0; overflow-x: auto; padding: 18px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-subtle); }
  .prose pre code { padding: 0; background: none; }
  .prose ul, .prose ol { margin-bottom: 1.5em; padding-left: 24px; }
  .prose li { margin-bottom: 0.4em; }
  .prose ul li { list-style: disc; }
  .prose ol li { list-style: decimal; }
  .prose table { width: 100%; margin: 2em 0; border-collapse: collapse; }
  .prose th, .prose td { padding: 10px 12px; border-bottom: 1px solid var(--color-border); text-align: left; font-size: 14px; vertical-align: top; }
  .prose th { color: var(--color-text-secondary); font-size: 12px; font-weight: 600; }
  .related-posts { margin-top: 20px; padding: 64px 0 88px; border-top: 1px solid var(--color-border); }
  .related-posts__inner { max-width: calc(var(--content-width) + 48px); }
  .related-posts__label { color: var(--color-accent); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .related-posts h2 { margin-top: 12px; font-size: clamp(1.45rem, 2.8vw, 2rem); }
  .related-posts__list { margin-top: 28px; border-top: 1px solid var(--color-border); }
  .related-posts__item { padding: 18px 0 20px; border-bottom: 1px solid var(--color-border); }
  .related-posts__item h3 { font-size: 1.1rem; }
  .related-posts__item h3 a { color: var(--color-text); text-decoration: none; }
  .related-posts__item h3 a:hover { color: var(--color-accent); }
  .related-posts__item p { margin-top: 7px; font-size: 13px; line-height: 1.55; }
  @media (max-width: 640px) { .post__breadcrumb { padding-inline: 18px; } .post { padding-inline: 18px; } .post__hero { margin-top: 20px; margin-bottom: 32px; } .post__meta { align-items: flex-start; flex-direction: column; gap: 3px; } }
</style>
