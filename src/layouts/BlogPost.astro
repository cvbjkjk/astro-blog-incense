---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagChip from '../components/TagChip.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getLangFromUrl } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & {
  related?: CollectionEntry<'blog'>[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, related = [] } = Astro.props;
const postURL = new URL(Astro.url.pathname, Astro.site);
const heroURL = heroImage ? new URL(heroImage, Astro.site) : null;
const lang = getLangFromUrl(Astro.url);
const isDe = lang === "de";
const homeHref = isDe ? "/de/" : "/";
const journalHref = isDe ? "/de/blog/" : "/blog/";
const homeLabel = isDe ? "Start" : "Home";
const journalLabel = isDe ? "Journal" : "Journal";

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  image: heroURL?.toString(),
  mainEntityOfPage: postURL.toString(),
  author: {
    '@type': 'Organization',
    name: 'naturalincense.de',
    url: new URL('/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'naturalincense.de',
    url: new URL('/', Astro.site).toString(),
  },
  inLanguage: lang,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: new URL(homeHref, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: journalLabel, item: new URL(journalHref, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: postURL.toString() },
  ],
};
---

<BaseLayout title={`${title} — INCENSE`} description={description} ogImage={heroURL?.toString()}>
  <div class="post__breadcrumb">
    <Breadcrumb
      crumbs={[
        { label: homeLabel, href: homeHref },
        { label: journalLabel, href: journalHref },
        { label: title },
      ]}
    />
  </div>
  <article class="post">
    {heroImage && (
      <div class="post__hero">
        <img src={heroImage} alt={title} />
      </div>
    )}

    <div class="post__header">
      <div class="post__meta">
        <time class="post__date">
          <FormattedDate date={pubDate} />
        </time>
        {updatedDate && (
          <span class="post__updated">
            Updated <FormattedDate date={updatedDate} />
          </span>
        )}
      </div>
      <h1 class="post__title">{title}</h1>
      {description && <p class="post__desc">{description}</p>}
      {tags && tags.length > 0 && (
        <div class="post__tags">
          {tags.map((tag) => <TagChip tag={tag} />)}
        </div>
      )}
    </div>

    <div class="prose">
      <slot />
    </div>
  </article>

  {related.length > 0 && (
    <section class="related-posts">
      <div class="container">
        <h2 class="related-posts__title">{isDe ? "Weiterlesen" : "Related Articles"}</h2>
        <div class="related-posts__grid">
          {related.map((r) => (
            <a href={`${journalHref}${r.id}/`} class="related-posts__card">
              <div class="related-posts__image">
                {r.data.heroImage ? (
                  <img src={r.data.heroImage} alt="" loading="lazy" />
                ) : (
                  <div class="related-posts__placeholder"><span>INCENSE</span></div>
                )}
              </div>
              <div class="related-posts__body">
                <h3 class="related-posts__name">{r.data.title}</h3>
                <p class="related-posts__desc">{r.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>

<style>
  .post {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 24px;
  }

  .post__hero {
    margin: 0 -24px 48px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .post__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__header {
    margin-bottom: 40px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .post__date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.03em;
  }

  .post__updated {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  .post__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 12px;
    letter-spacing: -0.03em;
  }

  .post__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }

  /* ---- Prose ---- */
  .prose {
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-text);
    padding-bottom: 80px;
  }

  .prose p {
    margin-bottom: 1.5em;
    color: var(--color-text);
    max-width: none;
  }

  .prose h2 {
    font-size: 1.5rem;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }

  .prose h3 {
    font-size: 1.2rem;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover {
    color: var(--color-accent-hover);
  }

  .prose img {
    border-radius: var(--radius-md);
    margin: 2em auto;
  }

  .prose blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 20px;
    margin: 2em 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .prose blockquote p {
    color: inherit;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2em 0;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 2px 6px;
    background: var(--color-surface-subtle);
    border-radius: 4px;
  }

  .prose pre {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px;
    overflow-x: auto;
    margin: 1.5em 0;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.5em;
    padding-left: 24px;
  }

  .prose li {
    margin-bottom: 0.4em;
  }

  .prose ul li {
    list-style: disc;
  }

  .prose ol li {
    list-style: decimal;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2em 0;
  }

  .prose th,
  .prose td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    font-size: 14px;
  }

  .prose th {
    font-weight: 550;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .post__hero {
      margin: 0 -24px 32px;
    }
  }

  /* ---- Related Posts ---- */
  .related-posts {
    padding: 64px 0 96px;
    border-top: 1px solid var(--color-border);
    margin-top: 64px;
  }

  .related-posts__title {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    margin-bottom: 24px;
  }

  .related-posts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .related-posts__card {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .related-posts__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .related-posts__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .related-posts__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-posts__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-subtle);
    color: var(--color-text-tertiary);
    font-family: var(--font-serif);
    letter-spacing: 0.1em;
  }

  .related-posts__body {
    padding: 14px 16px 18px;
  }

  .related-posts__name {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  .related-posts__desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .related-posts__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
