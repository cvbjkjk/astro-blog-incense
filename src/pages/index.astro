---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const materials = [
  {
    name: "Agarwood",
    latin: "Aquilaria sinensis",
    image: "/images/material-agarwood.jpg",
    desc: "The most precious incense material, formed when resin-infused heartwood undergoes years of natural transformation.",
  },
  {
    name: "Sandalwood",
    latin: "Santalum album",
    image: "/images/material-sandalwood.jpg",
    desc: "A warm, creamy wood with a sweet balsamic profile. Prized in meditation for its grounding presence.",
  },
  {
    name: "Frankincense",
    latin: "Boswellia sacra",
    image: "/images/material-frankincense.jpg",
    desc: "An aromatic resin with citrus-pine notes, used for thousands of years in spiritual ceremonies across cultures.",
  },
  {
    name: "Clove Bud",
    latin: "Syzygium aromaticum",
    image: "/images/material-clove.jpg",
    desc: "Dried flower buds that bring a sharp, warming spice to incense blends. A key note in many traditional formulas.",
  },
];
---

<BaseLayout
  title="Chinese Incense — History, Materials & Culture | naturalincense.de"
  description={SITE_DESCRIPTION}
>
  <!-- Announcement Banner -->
  <div class="announcement">
    <div class="container">
      <p class="announcement__text">Botanicals only — pure plant-based incense, hand rolled with intention</p>
    </div>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="hero__visual">
      <img src="/images/hero-home.jpg" alt="Incense smoke in a quiet meditation space" />
      <div class="hero__overlay"></div>
      <div class="container hero__content">
        <p class="hero__eyebrow">Journal of Chinese Incense</p>
        <h1 class="hero__title">The Art of <em class="hero__em">Incense</em></h1>
        <p class="hero__sub">
          A curated exploration of China's incense heritage — from wild-harvested agarwood to century-old blending traditions that shaped a culture.
        </p>
        <div class="hero__actions">
          <a href="/blog" class="btn btn-primary">Explore the Journal</a>
          <a href="/materials" class="btn btn-ghost">Discover Materials</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Pillars -->
  <section class="pillars">
    <div class="container">
      <div class="pillars__grid">
        <article class="pillar">
          <div class="pillar__icon">🌿</div>
          <h3 class="pillar__title">Botanicals Only</h3>
          <p class="pillar__desc">Purely plant-based materials — no synthetic fillers, no artificial perfume oils.</p>
        </article>
        <article class="pillar">
          <div class="pillar__icon">🤲</div>
          <h3 class="pillar__title">Hand Rolled</h3>
          <p class="pillar__desc">Artisanal craft in every stick, following traditions refined over centuries.</p>
        </article>
        <article class="pillar">
          <div class="pillar__icon">🌫️</div>
          <h3 class="pillar__title">Ingredient Honest</h3>
          <p class="pillar__desc">What you see is what you breathe — full transparency in every blend.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Featured Materials -->
  <section class="materials">
    <div class="container">
      <div class="section-label">
        <span class="section-label__line"></span>
        <span class="section-label__text">Raw Materials</span>
      </div>
      <h2 class="section-title">Essential Incense Materials</h2>
      <p class="section-desc">Four foundational ingredients that define the Chinese incense tradition.</p>
      <div class="materials__grid">
        {materials.map((m, i) => (
          <article class="material-card" style={`--reveal-delay: ${i * 0.1}s`}>
            <div class="material-card__image">
              <img src={m.image} alt="" loading="lazy" />
              <div class="material-card__overlay"></div>
              <span class="material-card__initial">{m.name[0]}</span>
            </div>
            <div class="material-card__body">
              <h3 class="material-card__name">{m.name}</h3>
              <p class="material-card__latin">{m.latin}</p>
              <p class="material-card__desc">{m.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="philosophy">
    <div class="container">
      <div class="philosophy__card">
        <blockquote class="philosophy__quote">
          <p>Incense is not merely fragrance — it is a bridge between the material and the spiritual, a practice that cultivates stillness in a restless world.</p>
        </blockquote>
        <p class="philosophy__attribution">From the ancient <cite>Xiang Pu</cite> (Incense Manuals) of the Song Dynasty</p>
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  {posts.length > 0 && (
    <section class="latest">
      <div class="container">
        <h2 class="section-title">Latest Writings</h2>
        <div class="latest__grid">
          {posts.map((post, i) => (
            <article class="post-card" style={`--reveal-delay: ${i * 0.1}s`}>
              <a href={`/blog/${post.id}/`} class="post-card__link" aria-label={post.data.title}>
                <div class="post-card__image">
                  {post.data.heroImage ? (
                    <img src={post.data.heroImage} alt="" loading="lazy" />
                  ) : (
                    <div class="post-card__placeholder">
                      <span>INCENSE</span>
                    </div>
                  )}
                </div>
              </a>
              <div class="post-card__body">
                <time class="post-card__date">
                  <FormattedDate date={post.data.pubDate} />
                </time>
                <h3 class="post-card__title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                {post.data.description && (
                  <p class="post-card__desc">{post.data.description}</p>
                )}
              </div>
            </article>
          ))}
        </div>
        <div class="latest__action">
          <a href="/blog" class="btn btn-ghost">View All Articles</a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <div class="section-label">
        <span class="section-label__line"></span>
        <span class="section-label__text">Good to Know</span>
      </div>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="faq__list">
        <details class="faq__item">
          <summary class="faq__question">What makes Chinese incense different from other traditions?</summary>
          <div class="faq__answer">
            <p>Chinese incense emphasizes whole botanicals and resins rather than synthetic fragrances. Blends follow the jun-chen (sovereign-minister) principle from classical medicine, where each ingredient plays a defined role — anchoring, supporting, or harmonizing the composition.</p>
          </div>
        </details>
        <details class="faq__item">
          <summary class="faq__question">How do I burn incense safely?</summary>
          <div class="faq__answer">
            <p>Always burn in a ventilated room, keep the burner at arm's length, use a stable heat-safe holder, and never leave burning incense unattended. A small tray or ash-catcher underneath keeps surfaces clean.</p>
          </div>
        </details>
        <details class="faq__item">
          <summary class="faq__question">Are there any hidden ingredients?</summary>
          <div class="faq__answer">
            <p>Never. Traditional Chinese incense uses ground botanicals, resins, and a natural tree-bark binder — no charcoal, no synthetic perfume oils. What you see is what you breathe.</p>
          </div>
        </details>
        <details class="faq__item">
          <summary class="faq__question">Which materials should a beginner start with?</summary>
          <div class="faq__answer">
            <p>Sandalwood is the classic starting point — warm, steady, and forgiving. Agarwood offers a deeper, more complex experience for when you're ready. Explore our <a href="/materials">materials directory</a> to learn more.</p>
          </div>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Announcement Banner ---- */
  .announcement {
    background: var(--color-accent);
    color: #fff;
    padding: 10px 0;
    text-align: center;
  }

  .announcement__text {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0;
    max-width: none;
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    min-height: 78dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__visual {
    position: absolute;
    inset: 0;
  }

  .hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(28, 38, 32, 0.35) 0%, rgba(28, 38, 32, 0.2) 45%, rgba(247, 236, 212, 0.95) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28vh 0 48px;
    color: #fff;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #f2e4c8;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.05;
    font-weight: 400;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .hero__em {
    font-style: italic;
    font-weight: 400;
    color: #f2e4c8;
    font-size: 1.05em;
  }

  .hero__sub {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
    max-width: 50ch;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.2);
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .hero .btn-ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(4px);
  }

  .hero .btn-ghost:hover {
    color: #fff;
    border-color: #fff;
    background: rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 640px) {
    .hero__content {
      padding: 20vh 0 32px;
    }
  }

  /* ---- Brand Pillars ---- */
  .pillars {
    padding: 64px 0;
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .pillar {
    text-align: center;
    padding: 24px 16px;
  }

  .pillar__icon {
    font-size: 32px;
    margin-bottom: 12px;
  }

  .pillar__title {
    font-size: 1.2rem;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .pillar__desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 auto;
    max-width: 30ch;
  }

  @media (max-width: 768px) {
    .pillars__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  /* ---- Section Shared ---- */
  .section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .section-label__line {
    width: 32px;
    height: 1px;
    background: var(--color-accent);
  }

  .section-label__text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .section-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 12px;
  }

  .section-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    margin-bottom: 48px;
  }

  /* ---- Materials ---- */
  .materials {
    padding: 80px 0;
  }

  .materials__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .material-card {
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
    animation: fade-up 0.7s var(--ease-spring) both;
    animation-delay: var(--reveal-delay, 0s);
  }

  .material-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .material-card__image {
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
  }

  .material-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .material-card:hover .material-card__image img {
    transform: scale(1.05);
  }

  .material-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 100%);
  }

  .material-card__initial {
    position: absolute;
    bottom: 12px;
    right: 16px;
    font-size: 40px;
    font-weight: 200;
    color: rgba(255, 255, 255, 0.3);
    font-family: var(--font-sans);
    line-height: 1;
  }

  .material-card__body {
    padding: 20px;
  }

  .material-card__name {
    font-size: 16px;
    font-weight: 550;
    margin-bottom: 2px;
  }

  .material-card__latin {
    font-size: 12px;
    font-style: italic;
    color: var(--color-text-tertiary);
    margin-bottom: 10px;
  }

  .material-card__desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ---- Philosophy ---- */
  .philosophy {
    padding: 80px 0;
  }

  .philosophy__card {
    padding: 64px 48px;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .philosophy__quote {
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.6;
    color: var(--color-text);
    font-weight: 400;
    font-style: italic;
    margin: 20px 0;
  }

  .philosophy__quote p {
    color: inherit;
    max-width: none;
  }

  .philosophy__attribution {
    font-size: 13px;
    color: var(--color-text-tertiary);
    cite {
      font-style: normal;
    }
  }

  /* ---- Latest Posts ---- */
  .latest {
    padding: 80px 0;
  }

  .latest__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .post-card {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
    animation: fade-up 0.7s var(--ease-spring) both;
    animation-delay: var(--reveal-delay, 0s);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .post-card__link {
    display: block;
    text-decoration: none;
  }

  .post-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .post-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .post-card:hover .post-card__image img {
    transform: scale(1.05);
  }

  .post-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-surface-subtle), var(--color-surface));
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-text-tertiary);
  }

  .post-card__body {
    padding: 20px;
  }

  .post-card__date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .post-card__title {
    font-size: 17px;
    font-weight: 550;
    margin: 6px 0 8px;
    color: var(--color-text);
  }

  .post-card__title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .post-card:hover .post-card__title a {
    color: var(--color-accent);
  }

  .post-card__desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .latest__action {
    text-align: center;
    margin-top: 48px;
  }

  /* ---- FAQ ---- */
  .faq {
    padding: 64px 0 96px;
  }

  .faq__list {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .faq__question {
    padding: 20px 8px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.2s var(--ease-out);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: "+";
    font-size: 20px;
    font-weight: 400;
    color: var(--color-accent);
    transition: transform 0.25s var(--ease-out);
  }

  .faq__item[open] .faq__question::after {
    transform: rotate(45deg);
  }

  .faq__question:hover {
    color: var(--color-accent);
  }

  .faq__answer {
    padding: 0 8px 20px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 62ch;
  }

  .faq__answer a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 1024px) {
    .materials__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .latest__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 70dvh;
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .philosophy__card {
      padding: 40px 24px;
    }
  }

  @media (max-width: 640px) {
    .materials__grid,
    .latest__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
