---
import { SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const materials = [
  { name: "Agarwood", latin: "Aquilaria sinensis", desc: "Resinous wood used for depth and change over heat." },
  { name: "Sandalwood", latin: "Santalum album", desc: "A soft wood note that often gives a blend structure." },
  { name: "Frankincense", latin: "Boswellia sacra", desc: "A resin material with a bright, balsamic profile." },
  { name: "Clove bud", latin: "Syzygium aromaticum", desc: "A dried spice used sparingly for warmth and lift." },
];
---

<BaseLayout title="Chinese Incense — Pellets, Materials & Notes | naturalincense.de" description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="container hero__layout">
      <div class="hero__copy">
        <p class="kicker">Incense pellets / inquiry-led</p>
        <h1>Incense pellets<br /><span>for slow heating.</span></h1>
        <p class="hero__intro">
          Ground botanicals and resins, hand-rolled for electric warmers. Formulas and availability are confirmed one enquiry at a time.
        </p>
        <div class="hero__actions">
          <a href="/inquire/?source=home" class="btn btn-primary">Ask about current availability</a>
          <a href="/xiang-wan/" class="hero__text-link">View pellets &amp; heating notes <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero__note">10 g / electric warmer / begin at 100–120°C</p>
      </div>
      <figure class="hero__figure">
        <img src="/images/xiangwan-02.jpg" alt="Close detail of hand-rolled incense pellets" fetchpriority="high" />
        <figcaption>Incense pellets / close detail</figcaption>
      </figure>
    </div>
  </section>

  <section class="working-notes" aria-labelledby="working-notes-title">
    <div class="container working-notes__layout">
      <div>
        <p class="kicker">How this work is offered</p>
        <h2 id="working-notes-title">A small working rhythm.</h2>
      </div>
      <dl class="working-notes__list">
        <div>
          <dt>Materials</dt>
          <dd>Ground botanicals and resins; no charcoal or synthetic perfume oils.</dd>
        </div>
        <div>
          <dt>Use</dt>
          <dd>Made for a temperature-controlled electric warmer, not direct flame.</dd>
        </div>
        <div>
          <dt>Availability</dt>
          <dd>Formulas are offered in small runs. Ask before planning an order.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="materials" aria-labelledby="materials-title">
    <div class="container">
      <div class="section-heading">
        <p class="kicker">Material index</p>
        <h2 id="materials-title">Four materials often met in the notes.</h2>
        <p>Names are a starting point, not a substitute for the way a finished blend develops on the warmer.</p>
      </div>
      <div class="materials__list">
        {materials.map((material, index) => (
          <article class="material-row">
            <p class="material-row__number" aria-hidden="true">0{index + 1}</p>
            <div>
              <h3>{material.name}</h3>
              <p class="material-row__latin">{material.latin}</p>
            </div>
            <p class="material-row__desc">{material.desc}</p>
          </article>
        ))}
      </div>
      <a href="/materials/" class="section-link">Read the material index <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="journal" aria-labelledby="journal-title">
      <div class="container">
        <div class="section-heading">
          <p class="kicker">Journal</p>
          <h2 id="journal-title">Notes for the warmer.</h2>
        </div>
        <div class="journal__grid">
          <article class="journal__featured">
            <time><FormattedDate date={posts[0].data.pubDate} /></time>
            <h3><a href={`/blog/${posts[0].id}/`}>{posts[0].data.title}</a></h3>
            {posts[0].data.description && <p>{posts[0].data.description}</p>}
            <a href={`/blog/${posts[0].id}/`} class="journal__read">Read note <span aria-hidden="true">→</span></a>
          </article>
          {posts.slice(1).length > 0 && (
            <div class="journal__list">
              {posts.slice(1).map((post) => (
                <article class="journal__item">
                  <time><FormattedDate date={post.data.pubDate} /></time>
                  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                  {post.data.description && <p>{post.data.description}</p>}
                </article>
              ))}
            </div>
          )}
        </div>
        <a href="/blog/" class="section-link">All journal notes <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  <section class="newsletter" aria-labelledby="newsletter-title">
    <div class="container newsletter__layout">
      <div>
        <p class="kicker">Occasional correspondence</p>
        <h2 id="newsletter-title">Notes on materials, blends and use.</h2>
      </div>
      <form class="newsletter__form" action="https://naturalincense.substack.com/api/v1/free?nojs=true" method="POST" target="_blank">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input id="newsletter-email" type="email" name="email" class="newsletter__input" placeholder="Email address" required />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(52px, 8vw, 104px) 0 clamp(64px, 9vw, 116px); border-bottom: 1px solid var(--color-border); }
  .hero__layout { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.8fr); gap: clamp(40px, 8vw, 120px); align-items: end; }
  .kicker { color: var(--color-accent); font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.08em; line-height: 1.4; text-transform: uppercase; }
  .hero h1 { max-width: 11ch; margin-top: 18px; }
  .hero h1 span { color: var(--color-text-secondary); }
  .hero__intro { max-width: 47ch; margin-top: 24px; font-size: 16px; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 28px; }
  .hero__text-link, .section-link, .journal__read { color: var(--color-text); font-size: 13px; font-weight: 500; text-decoration: none; }
  .hero__text-link span, .section-link span, .journal__read span { display: inline-block; margin-left: 5px; color: var(--color-accent); }
  .hero__note { margin-top: 34px; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; }
  .hero__figure { margin: 0; }
  .hero__figure img { aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--color-border); }
  .hero__figure figcaption { margin-top: 9px; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; }
  .working-notes, .materials, .journal, .newsletter { padding: clamp(64px, 8vw, 112px) 0; }
  .working-notes { background: var(--color-surface-subtle); }
  .working-notes__layout { display: grid; grid-template-columns: minmax(210px, 0.6fr) minmax(0, 1fr); gap: clamp(32px, 8vw, 130px); }
  .working-notes h2, .section-heading h2, .newsletter h2 { max-width: 16ch; margin-top: 14px; }
  .working-notes__list { border-top: 1px solid var(--color-border); }
  .working-notes__list > div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--color-border); }
  .working-notes dt, .material-row__number, .journal time { color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; }
  .working-notes dd { color: var(--color-text-secondary); font-size: 14px; line-height: 1.6; }
  .section-heading > p:not(.kicker) { margin-top: 16px; font-size: 15px; }
  .materials__list { margin-top: 40px; border-top: 1px solid var(--color-border); }
  .material-row { display: grid; grid-template-columns: 48px minmax(160px, 0.75fr) minmax(0, 1fr); gap: 18px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--color-border); }
  .material-row h3 { font-size: 1.1rem; }
  .material-row__latin { margin-top: 4px; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; }
  .material-row__desc { font-size: 14px; line-height: 1.55; }
  .section-link { display: inline-block; margin-top: 24px; }
  .journal { border-top: 1px solid var(--color-border); }
  .journal__grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.75fr); gap: clamp(32px, 7vw, 104px); margin-top: 42px; }
  .journal__featured { padding-right: clamp(0px, 4vw, 64px); }
  .journal__featured h3 { max-width: 18ch; margin-top: 12px; font-size: clamp(1.55rem, 2.7vw, 2.3rem); }
  .journal h3 a { color: var(--color-text); text-decoration: none; }
  .journal h3 a:hover { color: var(--color-accent); }
  .journal__featured p { margin-top: 17px; font-size: 14px; }
  .journal__read { display: inline-block; margin-top: 22px; }
  .journal__list { border-top: 1px solid var(--color-border); }
  .journal__item { padding: 18px 0 22px; border-bottom: 1px solid var(--color-border); }
  .journal__item h3 { margin-top: 8px; font-size: 1.12rem; }
  .journal__item p { margin-top: 8px; font-size: 13px; line-height: 1.55; }
  .newsletter { padding-top: 0; }
  .newsletter__layout { display: flex; align-items: end; justify-content: space-between; gap: 32px; padding-top: 34px; border-top: 1px solid var(--color-border); }
  .newsletter h2 { font-size: clamp(1.35rem, 2.4vw, 1.8rem); }
  .newsletter__form { display: flex; gap: 8px; width: min(100%, 420px); }
  .newsletter__input { flex: 1; min-width: 0; min-height: 42px; padding: 9px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text); font: inherit; font-size: 13px; }
  @media (max-width: 760px) { .hero__layout, .working-notes__layout, .journal__grid { grid-template-columns: 1fr; } .hero__figure { max-width: 460px; } .working-notes h2, .section-heading h2, .newsletter h2 { max-width: 20ch; } .newsletter__layout { display: grid; align-items: start; } }
  @media (max-width: 520px) { .hero { padding-top: 38px; } .hero__actions, .newsletter__form { align-items: stretch; flex-direction: column; } .material-row { grid-template-columns: 34px 1fr; gap: 10px; } .material-row__desc { grid-column: 2; margin-top: 2px; } .working-notes__list > div { grid-template-columns: 1fr; gap: 4px; } }
</style>
