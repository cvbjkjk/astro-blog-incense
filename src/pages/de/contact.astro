---
import Layout from '../../layouts/BaseLayout.astro';
---

<Layout
  title="Kontakt — naturalincense.de"
  description="Kontaktiere uns zu Räucherkugeln, Materialien oder Kooperationen — wir antworten gerne."
>
  <section class="contact-hero">
    <div class="container">
      <p class="contact-hero__label">Verbinden</p>
      <h1 class="contact-hero__title">Kontakt aufnehmen</h1>
      <p class="contact-hero__sub">Fragen zu Räucherkugeln, Materialien oder Kooperationen? Schreib uns — wir antworten gerne.</p>
    </div>
  </section>

  <section class="contact-body">
    <div class="container">
      <div class="contact__grid">
        <form class="contact__form" action="https://formsubmit.co/hello@naturalincense.de" method="POST">
          <input type="hidden" name="_subject" value="Kontaktanfrage von naturalincense.de" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" />
          <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="field">
            <label for="email">E-Mail</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="field">
            <label for="message">Nachricht</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="contact__submit">Nachricht senden</button>
          <p class="contact__status" data-status></p>
        </form>
        <aside class="contact__info">
          <h2 class="contact__info-title">Direkt erreichbar</h2>
          <p class="contact__info-text">
            Bevorzugst du direktes Schreiben? Erreiche uns unter:
          </p>
          <p class="contact__email">
            <a href="mailto:hello@naturalincense.de">hello@naturalincense.de</a>
          </p>
          <p class="contact__info-text">
            Wir antworten in der Regel innerhalb von 1–2 Werktagen.
          </p>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-hero { padding: 64px 0 48px; }
  .contact-hero__label { font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 12px; }
  .contact-hero__title { font-size: clamp(2.4rem, 5vw, 3.6rem); margin-bottom: 16px; }
  .contact-hero__sub { font-size: 16px; color: var(--color-text-secondary); max-width: 55ch; }
  .contact-body { padding-bottom: 96px; }
  .contact__grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start; }
  .contact__form { display: flex; flex-direction: column; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 13px; font-weight: 500; color: var(--color-text); }
  .field input, .field textarea { width: 100%; padding: 12px 14px; font-size: 15px; font-family: var(--font-sans); color: var(--color-text); background: var(--color-surface-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-sizing: border-box; transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out); }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px var(--color-accent-subtle); }
  .field textarea { resize: vertical; min-height: 120px; line-height: 1.6; }
  .contact__submit { width: 100%; padding: 14px 32px; background: var(--color-accent); color: #fff; font-size: 14px; font-weight: 500; font-family: var(--font-sans); border: none; border-radius: var(--radius-md); cursor: pointer; transition: background 0.25s var(--ease-out); }
  .contact__submit:hover { background: var(--color-accent-hover); }
  .contact__status { font-size: 13px; min-height: 18px; }
  .contact__status.is-success { color: var(--color-forest); }
  .contact__status.is-error { color: #8b0000; }
  .contact__info { padding: 32px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .contact__info-title { font-size: 1.2rem; margin-bottom: 14px; }
  .contact__info-text { font-size: 14px; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: 12px; }
  .contact__email { font-size: 16px; font-weight: 500; margin-bottom: 12px; }
  .contact__email a { color: var(--color-accent); text-decoration: none; }
  .contact__email a:hover { text-decoration: underline; }
  @media (max-width: 768px) { .contact__grid { grid-template-columns: 1fr; gap: 32px; } }
</style>

<script>
  const form = document.querySelector(".contact__form");
  const status = document.querySelector("[data-status]");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector(".contact__submit");
    btn.disabled = true;
    btn.textContent = "Senden...";
    try {
      const res = await fetch(form.action + "?ajax=true", {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        status.textContent = "Vielen Dank! Deine Nachricht wurde gesendet.";
        status.className = "contact__status is-success";
        form.reset();
      } else {
        throw new Error("send failed");
      }
    } catch {
      status.textContent = "Etwas ist schiefgelaufen. Bitte schreib direkt an hello@naturalincense.de.";
      status.className = "contact__status is-error";
    }
    btn.disabled = false;
    btn.textContent = "Nachricht senden";
  });
</script>
