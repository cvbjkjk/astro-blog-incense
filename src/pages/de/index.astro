---
import { de } from '../../i18n/de-content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const materials = [
  { name: "Agarholz", latin: "Aquilaria sinensis", desc: "Das kostbarste Räucherholz der Welt — dunkel, harzig und tief.", image: "/images/material-agarwood.jpg" },
  { name: "Sandelholz", latin: "Santalum album", desc: "Cremig, warm und süß — der klassische Einstieg.", image: "/images/material-sandalwood.jpg" },
  { name: "Weihrauch", latin: "Boswellia carterii", desc: "Zitrus-Kiefer-Öffnung mit warmer, balsamischer Tiefe.", image: "/images/material-frankincense.jpg" },
  { name: "Gewürznelke", latin: "Syzygium aromaticum", desc: "Scharf, wärmend und süß — ein kräftiger Charakter.", image: "/images/material-clove.jpg" },
];
const t = de.home;
---

<BaseLayout
  title="Chinesisches Räuchern — Geschichte, Materialien &amp; Kultur | naturalincense.de"
  description={SITE_DESCRIPTION}
>
  <!-- Announcement -->
  <div class="announcement">
    <div class="container">
      <p class="announcement__text">Kostenloser Versand ab 60 $ · Handgerollte Botanik, weltweiter Versand</p>
    </div>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="hero__visual">
      <img src="/images/hero-home.jpg" alt="Räucherduft in einem ruhigen Meditationsraum" />
      <div class="hero__overlay"></div>
    </div>
    <div class="container hero__content">
      <p class="hero__eyebrow">{t.eyebrow}</p>
      <h1 class="hero__title" set:html={t.title}></h1>
      <p class="hero__sub">{t.sub}</p>
      <div class="hero__actions">
        <a href="/de/blog/" class="btn btn-primary">{t.ctaPrimary}</a>
        <a href="/de/materials/" class="btn btn-ghost">{t.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <!-- Brand Pillars -->
  <section class="pillars">
    <div class="container">
      <div class="pillars__grid">
        <article class="pillar">
          <div class="pillar__icon">🌿</div>
          <h3 class="pillar__title">{t.pillar1Title}</h3>
          <p class="pillar__desc">{t.pillar1Desc}</p>
        </article>
        <article class="pillar">
          <div class="pillar__icon">🤲</div>
          <h3 class="pillar__title">{t.pillar2Title}</h3>
          <p class="pillar__desc">{t.pillar2Desc}</p>
        </article>
        <article class="pillar">
          <div class="pillar__icon">🌫️</div>
          <h3 class="pillar__title">{t.pillar3Title}</h3>
          <p class="pillar__desc">{t.pillar3Desc}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Materials -->
  <section class="materials">
    <div class="container">
      <div class="section-label">
        <span class="section-label__line"></span>
        <span class="section-label__text">{t.materialsLabel}</span>
      </div>
      <h2 class="section-title">{t.materialsTitle}</h2>
      <p class="section-desc">{t.materialsDesc}</p>
      <div class="materials__grid">
        {materials.map((m, i) => (
          <article class="material-card" style={`--reveal-delay: ${i * 0.1}s`}>
            <div class="material-card__image">
              <img src={m.image} alt="" loading="lazy" />
              <div class="material-card__overlay"></div>
              <span class="material-card__initial">{m.name[0]}</span>
            </div>
            <div class="material-card__body">
              <h3 class="material-card__name">{m.name}</h3>
              <p class="material-card__latin">{m.latin}</p>
              <p class="material-card__desc">{m.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Posts -->
  {posts.length > 0 && (
    <section class="latest">
      <div class="container">
        <h2 class="section-title">{t.latestTitle}</h2>
        <div class="latest__grid">
          {posts.slice(0, 3).map((post, i) => (
            <article class="post-card" style={`--reveal-delay: ${i * 0.1}s`}>
              <a href={`/de/blog/${post.id}/`} class="post-card__link" aria-label={post.data.title}>
                <div class="post-card__image">
                  {post.data.heroImage ? (
                    <img src={post.data.heroImage} alt="" loading="lazy" />
                  ) : (
                    <div class="post-card__placeholder"><span>INCENSE</span></div>
                  )}
                </div>
              </a>
              <div class="post-card__body">
                <time class="post-card__date"><FormattedDate date={post.data.pubDate} /></time>
                <h3 class="post-card__title"><a href={`/de/blog/${post.id}/`}>{post.data.title}</a></h3>
                {post.data.description && <p class="post-card__desc">{post.data.description}</p>}
              </div>
            </article>
          ))}
        </div>
        <div class="latest__action">
          <a href="/de/blog/" class="btn btn-ghost">{t.viewAll}</a>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <div class="section-label">
        <span class="section-label__line"></span>
        <span class="section-label__text">{t.faqLabel}</span>
      </div>
      <h2 class="section-title">{t.faqTitle}</h2>
      <div class="faq__list">
        {de.faq.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">{item.q}</summary>
            <div class="faq__answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter">
    <div class="container">
      <div class="newsletter__inner">
        <h2 class="newsletter__title">{t.newsletterTitle}</h2>
        <p class="newsletter__desc">{t.newsletterDesc}</p>
        <form class="newsletter__form" action="https://formsubmit.co/hello@naturalincense.de" method="POST">
          <input type="hidden" name="_subject" value="Newsletter-Anmeldung von naturalincense.de" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="email" name="email" class="newsletter__input" placeholder={t.newsletterPlaceholder} required />
          <button type="submit" class="newsletter__btn">{t.newsletterBtn}</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .announcement { background: var(--color-accent); color: #fff; padding: 10px 0; text-align: center; }
  .announcement__text { font-size: 13px; letter-spacing: 0.04em; color: #fff; margin: 0; max-width: none; }
  .hero { position: relative; min-height: 78dvh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero__visual { position: absolute; inset: 0; }
  .hero__visual img { width: 100%; height: 100%; object-fit: cover; }
  .hero__overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(28,38,32,0.35) 0%, rgba(28,38,32,0.2) 45%, rgba(247,236,212,0.95) 100%); }
  .hero__content { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 18px; padding: 28vh 0 48px; color: #fff; }
  .hero__eyebrow { font-family: var(--font-mono); font-size: 12px; color: #f2e4c8; letter-spacing: 0.15em; text-transform: uppercase; }
  .hero__title { font-size: clamp(2.8rem, 6vw, 5rem); line-height: 1.05; font-weight: 400; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,0.25); }
  .hero__title em { font-style: italic; color: #f2e4c8; }
  .hero__sub { font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.92); max-width: 50ch; text-shadow: 0 1px 8px rgba(0,0,0,0.2); }
  .hero__actions { display: flex; gap: 12px; margin-top: 8px; }
  .hero .btn-ghost { color: #fff; border-color: rgba(255,255,255,0.7); background: rgba(0,0,0,0.15); backdrop-filter: blur(4px); }
  .hero .btn-ghost:hover { color: #fff; border-color: #fff; background: rgba(0,0,0,0.25); }
  @media (max-width: 640px) { .hero__content { padding: 20vh 0 32px; } }
  .pillars { padding: 64px 0; }
  .pillars__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .pillar { text-align: center; padding: 24px 16px; }
  .pillar__icon { font-size: 32px; margin-bottom: 12px; }
  .pillar__title { font-size: 1.2rem; margin-bottom: 8px; }
  .pillar__desc { font-size: 13px; line-height: 1.6; color: var(--color-text-secondary); margin: 0 auto; max-width: 30ch; }
  @media (max-width: 768px) { .pillars__grid { grid-template-columns: 1fr; gap: 16px; } }
  .materials { padding: 24px 0 64px; }
  .section-label { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .section-label__line { width: 32px; height: 1px; background: var(--color-accent); }
  .section-label__text { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); }
  .section-title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 12px; }
  .section-desc { font-size: 15px; color: var(--color-text-secondary); margin-bottom: 32px; }
  .materials__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .material-card { border-radius: var(--radius-lg); overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border); transition: transform 0.3s var(--ease-out); }
  .material-card:hover { transform: translateY(-4px); }
  .material-card__image { position: relative; aspect-ratio: 4/3; overflow: hidden; }
  .material-card__image img { width: 100%; height: 100%; object-fit: cover; }
  .material-card__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.35), transparent 50%); }
  .material-card__initial { position: absolute; bottom: 10px; left: 14px; font-family: var(--font-serif); font-size: 28px; color: rgba(255,255,255,0.9); }
  .material-card__body { padding: 16px 18px 20px; }
  .material-card__name { font-size: 16px; margin-bottom: 4px; }
  .material-card__latin { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-tertiary); margin-bottom: 8px; }
  .material-card__desc { font-size: 13px; line-height: 1.6; color: var(--color-text-secondary); }
  .latest { padding: 24px 0 64px; }
  .latest__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }
  .post-card { border-radius: var(--radius-lg); overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border); transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out); }
  .post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .post-card__image { aspect-ratio: 16/9; overflow: hidden; }
  .post-card__image img { width: 100%; height: 100%; object-fit: cover; }
  .post-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--color-surface-subtle); color: var(--color-text-tertiary); font-family: var(--font-serif); letter-spacing: 0.1em; }
  .post-card__body { padding: 16px 18px 20px; }
  .post-card__date { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-tertiary); }
  .post-card__title { font-size: 15px; margin: 6px 0 8px; }
  .post-card__title a { color: var(--color-text); text-decoration: none; transition: color 0.2s ease; }
  .post-card__title a:hover { color: var(--color-accent); }
  .post-card__desc { font-size: 13px; line-height: 1.5; color: var(--color-text-secondary); }
  .latest__action { text-align: center; margin-top: 48px; }
  .faq { padding: 64px 0 96px; }
  .faq__list { max-width: 720px; margin: 0 auto; }
  .faq__item { border-bottom: 1px solid var(--color-border); }
  .faq__item:first-child { border-top: 1px solid var(--color-border); }
  .faq__question { padding: 20px 8px; font-family: var(--font-sans); font-size: 15px; font-weight: 500; color: var(--color-text); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; transition: color 0.2s var(--ease-out); }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::after { content: "+"; font-size: 20px; font-weight: 400; color: var(--color-accent); transition: transform 0.25s var(--ease-out); }
  .faq__item[open] .faq__question::after { transform: rotate(45deg); }
  .faq__question:hover { color: var(--color-accent); }
  .faq__answer { padding: 0 8px 20px; font-size: 14px; line-height: 1.7; color: var(--color-text-secondary); max-width: 62ch; }
  .newsletter { padding: 72px 0 96px; }
  .newsletter__inner { max-width: 560px; margin: 0 auto; text-align: center; padding: 48px 40px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); }
  .newsletter__title { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 12px; }
  .newsletter__desc { font-size: 14px; color: var(--color-text-secondary); margin: 0 auto 28px; max-width: 40ch; line-height: 1.6; }
  .newsletter__form { display: flex; gap: 8px; max-width: 420px; margin: 0 auto; }
  .newsletter__input { flex: 1; padding: 12px 16px; font-size: 14px; font-family: var(--font-sans); color: var(--color-text); background: var(--color-surface-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .newsletter__input:focus { outline: none; border-color: var(--color-accent); }
  .newsletter__btn { padding: 12px 24px; font-size: 14px; font-weight: 500; font-family: var(--font-sans); color: #fff; background: var(--color-accent); border: none; border-radius: var(--radius-md); cursor: pointer; white-space: nowrap; }
  .newsletter__btn:hover { background: var(--color-accent-hover); }
  @media (max-width: 1024px) { .materials__grid, .latest__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .hero { min-height: 70dvh; } .hero__actions { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 640px) { .materials__grid, .latest__grid { grid-template-columns: 1fr; } .newsletter__form { flex-direction: column; } }
</style>
