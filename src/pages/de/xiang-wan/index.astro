---
import Layout from '../../../layouts/BaseLayout.astro';

const formulas = [
  { nameCn: "青麟髓", nameEn: "Qing Lin Sui", status: "Neue Rezeptur", note: "Ein kühler, klarer Auftakt, der sich mit steigender Temperatur verändert." },
  { nameCn: "春月蝴蝶香", nameEn: "Spring Moon Butterfly", status: "Historische Referenz", note: "Ein leicht blumiges Profil, nah an einer historischen Vorlage." },
  { nameCn: "汉建宁宫中香", nameEn: "Han Jianning Palace Incense", status: "Historische Referenz", note: "Ein warmes, ausgewogenes Profil aus einer Han-zeitlichen Tradition." },
  { nameCn: "旷野幽兰", nameEn: "Wild Orchid of the Wilderness", status: "Eigene Kreation", note: "Grün, still und leicht ungezähmt." },
  { nameCn: "寿阳公主梅花香", nameEn: "Princess Shouyang Plum Blossom", status: "Historische Referenz", note: "Ein Pflaumenblütenprofil mit kühlem ersten Eindruck." },
  { nameCn: "荀令十里香", nameEn: "Xun Ling's Ten-Mile Fragrance", status: "Historische Referenz", note: "Ein anhaltendes Profil, benannt nach einer bekannten historischen Anekdote." },
  { nameCn: "莉莉玛莲", nameEn: "Lili Marleen", status: "Eigene Kreation", note: "Eine rauchige, intime Mischung als Widmung an Marlene Dietrich." },
];

const images = [
  { src: "/images/xiangwan-02.jpg", alt: "Nahaufnahme von handgeformten Räucherpellets" },
  { src: "/images/xiangwan-03.jpg", alt: "Handgeformte Räucherpellets für ein elektrisches Stövchen" },
  { src: "/images/xiangwan-01.jpg", alt: "Handgeformte Räucherpellets in einer Metallschale" },
];
---

<Layout
  title="Räucherpellets — Handgeformtes Xiang Wan für elektrische Stövchen | naturalincense.de"
  description="Handgeformte Räucherpellets (Xiang Wan) für temperaturgeregelte elektrische Stövchen. Sieben historische Referenzen und eigene Rezepturen. Bei 100–120 °C beginnen und die Temperatur langsam erhöhen."
  ogImage="/images/xiangwan-01.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Handgeformte Räucherpellets (Xiang Wan 香丸)",
    "description": "Handgeformte Räucherpellets für elektrische Stövchen aus gemahlenen Pflanzenstoffen und Harzen.",
    "image": images.map((image) => `https://naturalincense.de${image.src}`),
    "brand": { "@type": "Brand", "name": "INCENSE" },
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/LimitedAvailability",
      "priceCurrency": "EUR",
      "price": "12.00",
      "url": "https://naturalincense.de/de/xiang-wan/"
    }
  })} />

  <section class="product">
    <div class="container product__layout">
      <div class="product__gallery">
        <figure class="product__main-image">
          <img src={images[0].src} alt={images[0].alt} fetchpriority="high" />
        </figure>
        <div class="product__details" aria-label="Weitere Ansichten der Räucherpellets">
          {images.slice(1).map((image) => <img src={image.src} alt={image.alt} loading="lazy" />)}
        </div>
      </div>

      <div class="product__info">
        <p class="kicker">Xiang Wan / für elektrische Stövchen</p>
        <h1>Räucherpellets <span>香丸</span></h1>
        <p class="product__intro">
          Kleine Pellets aus gemahlenen Pflanzenstoffen und Harzen. Keine Holzkohle. Keine synthetischen Duftöle. Sanft auf einem temperaturgeregelten elektrischen Stövchen erhitzen.
        </p>

        <dl class="product__record">
          <div><dt>Rezepturen</dt><dd>7 / historische Referenzen und eigene Kreationen</dd></div>
          <div><dt>Preis</dt><dd>€12,00 / 10 g</dd></div>
          <div><dt>Gerät</dt><dd>Temperaturgeregeltes elektrisches Stövchen</dd></div>
          <div><dt>Temperatur</dt><dd>Bei 100–120 °C beginnen; langsam auf 180–200 °C erhöhen</dd></div>
        </dl>

        <a href="/de/anfragen/?source=pellets" class="btn btn-primary product__cta">Aktuelle Verfügbarkeit anfragen</a>
        <p class="product__cta-note">Frage nach den aktuell hergestellten Rezepturen und nenne das Stövchen, das du verwendest.</p>
      </div>
    </div>
  </section>

  <section class="product-note" aria-labelledby="product-note-title">
    <div class="container product-note__layout">
      <p class="kicker">Notiz zur Herstellung</p>
      <div>
        <h2 id="product-note-title">Eine Notiz zu den Pellets.</h2>
        <p>Nach Rückmeldungen zur ersten Charge wurden die Pellets kleiner. Dadurch lässt sich eine Sitzung leichter Stück für Stück anpassen. Der Temperaturbereich ist ein Anhaltspunkt, keine starre Regel: Jedes Stövchen öffnet eine Mischung etwas anders.</p>
        <p>Als praktischer Anfang gilt: niedrig starten und die Temperatur erst erhöhen, wenn der erste Eindruck Zeit hatte, sich zu setzen.</p>
        <a href="/de/blog/how-to-heat-incense-pellets/" class="section-link">Heizanleitung lesen <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="formulas" aria-labelledby="formulas-title">
    <div class="container">
      <div class="formulas__heading">
        <p class="kicker">Rezepturindex</p>
        <h2 id="formulas-title">Sieben benannte Rezepturen.</h2>
        <p>Einige beziehen sich auf historische Quellen, andere sind eigene Kompositionen. Die Namen erleichtern das Gespräch in einer Anfrage.</p>
      </div>
      <div class="formulas__list">
        {formulas.map((formula, index) => (
          <article class="formula-row">
            <p class="formula-row__number" aria-hidden="true">0{index + 1}</p>
            <div>
              <h3>{formula.nameCn} <span>· {formula.nameEn}</span></h3>
              <p class="formula-row__status">{formula.status}</p>
            </div>
            <p class="formula-row__note">{formula.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .product { padding: 48px 0 clamp(64px, 8vw, 104px); }
  .product__layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.8fr); gap: clamp(40px, 8vw, 112px); align-items: start; }
  .product__gallery { position: sticky; top: 84px; }
  .product__main-image { margin: 0; overflow: hidden; border: 1px solid var(--color-border); }
  .product__main-image img { aspect-ratio: 4 / 5; object-fit: cover; }
  .product__details { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .product__details img { aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--color-border); }
  .product__info { padding-top: 8px; }
  .kicker { color: var(--color-accent); font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .product h1 { margin-top: 16px; }
  .product h1 span { color: var(--color-text-secondary); font-family: var(--font-sans); font-size: 0.78em; letter-spacing: 0; }
  .product__intro { margin-top: 22px; font-size: 16px; }
  .product__record { margin-top: 30px; border-top: 1px solid var(--color-border); }
  .product__record > div { display: grid; grid-template-columns: 118px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-border); }
  .product__record dt, .formula-row__number { color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; }
  .product__record dd { color: var(--color-text-secondary); font-size: 13px; line-height: 1.55; }
  .product__cta { margin-top: 24px; }
  .product__cta-note { margin-top: 10px; color: var(--color-text-tertiary); font-size: 12px; }
  .product-note { padding: clamp(56px, 8vw, 94px) 0; background: var(--color-surface-subtle); }
  .product-note__layout { display: grid; grid-template-columns: minmax(180px, 0.45fr) minmax(0, 0.75fr); gap: clamp(32px, 8vw, 130px); }
  .product-note h2 { margin-bottom: 18px; }
  .product-note div > p + p { margin-top: 14px; }
  .section-link { display: inline-block; margin-top: 22px; color: var(--color-text); font-size: 13px; font-weight: 500; text-decoration: none; }
  .section-link span { margin-left: 5px; color: var(--color-accent); }
  .formulas { padding: clamp(64px, 8vw, 110px) 0; }
  .formulas__heading > p:not(.kicker) { max-width: 57ch; margin-top: 16px; font-size: 15px; }
  .formulas__heading h2 { margin-top: 14px; }
  .formulas__list { margin-top: 38px; border-top: 1px solid var(--color-border); }
  .formula-row { display: grid; grid-template-columns: 48px minmax(220px, 0.85fr) minmax(0, 1fr); gap: 18px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--color-border); }
  .formula-row h3 { font-size: 1.05rem; }
  .formula-row h3 span { color: var(--color-text-secondary); font-family: var(--font-sans); font-size: 0.94em; font-weight: 450; letter-spacing: 0; }
  .formula-row__status { margin-top: 5px; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; }
  .formula-row__note { font-size: 14px; line-height: 1.55; }
  @media (max-width: 820px) { .product__layout, .product-note__layout { grid-template-columns: 1fr; } .product__gallery { position: static; max-width: 520px; } }
  @media (max-width: 560px) { .product { padding-top: 28px; } .product__record > div { grid-template-columns: 1fr; gap: 2px; } .formula-row { grid-template-columns: 34px 1fr; gap: 10px; } .formula-row__note { grid-column: 2; margin-top: 2px; } }
</style>
