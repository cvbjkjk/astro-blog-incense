---
import Layout from '../../layouts/BaseLayout.astro';

const formulas = [
  {
    name_cn: "青麟髓",
    name_en: "Qing Lin Sui",
    note: "New release · 凉意突出",
    desc: "The newest formula, with a strikingly cool, clear opening — designed to be savored as the temperature rises.",
    source: "New release",
  },
  {
    name_cn: "春月蝴蝶香",
    name_en: "Spring Moon Butterfly",
    note: "按原方",
    desc: "A gentle spring-floral blend, made close to the original historical formula.",
    source: "Based on the original formula",
  },
  {
    name_cn: "汉建宁宫中香",
    name_en: "Han Jianning Palace Incense",
    note: "按原方",
    desc: "A palace incense from the Han dynasty tradition — rich, warm, and composed.",
    source: "Based on the original formula",
  },
  {
    name_cn: "旷野幽兰",
    name_en: "Wild Orchid of the Wilderness",
    note: "自创香方",
    desc: "An original creation — a lone orchid in the open field: green, quiet, and slightly wild.",
    source: "Original creation",
  },
  {
    name_cn: "寿阳公主梅花香",
    name_en: "Princess Shouyang Plum Blossom",
    note: "按原方",
    desc: "Plum blossom incense in the tradition of Princess Shouyang — crisp, cool, and poetic.",
    source: "Based on the original formula",
  },
  {
    name_cn: "荀令十里香",
    name_en: "Xun Ling's Ten-Mile Fragrance",
    note: "按原方",
    desc: "The legendary fragrance said to linger for ten li — refined and long-lasting.",
    source: "Based on the original formula",
  },
  {
    name_cn: "莉莉玛莲",
    name_en: "Lili Marleen",
    note: "原创香方",
    desc: "An original blend dedicated to Marlene Dietrich — an irreplaceable legend of the screen: smoky, magnetic, unforgettable.",
    source: "Original creation, dedicated to Marlene Dietrich",
  },
];

const images = [
  { src: "/images/xiangwan-01.jpg", alt: "Hand-rolled incense pellets (xiang wan)" },
  { src: "/images/xiangwan-02.jpg", alt: "Hand-rolled incense pellets — close detail" },
  { src: "/images/xiangwan-03.jpg", alt: "Hand-rolled incense pellets ready for the warmer" },
];
---

<Layout
  title="Hand-Rolled Incense Pellets (Xiang Wan 香丸) — Traditional Chinese Formulas | naturalincense.de"
  description="Hand-rolled Chinese incense pellets (xiang wan) for electric warmers. Seven traditional and original formulas — Qing Lin Sui, Spring Moon Butterfly, Han Jianning Palace and more. Heat at 100–120°C, rise slowly toward 180–200°C."
  ogImage="/images/xiangwan-01.jpg"
>
  <!-- JSON-LD Product schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Hand-Rolled Incense Pellets (Xiang Wan 香丸)",
    "description": "Hand-rolled Chinese incense pellets for electric warmers. Seven traditional and original formulas, made in small batches from ground botanicals and resins.",
    "image": images.map((i) => `https://naturalincense.de${i.src}`),
    "brand": { "@type": "Brand", "name": "INCENSE" },
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "EUR",
      "url": "https://naturalincense.de/xiang-wan/"
    }
  })} />

  <section class="product">
    <div class="container product__layout">
      <!-- Gallery -->
      <div class="product__gallery" data-gallery>
        <div class="product__carousel">
          <div class="product__main-image" data-main-image>
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class={i === 0 ? "is-active" : ""}
                data-slide
              />
            ))}
          </div>
          <button class="product__arrow product__arrow--prev" type="button" data-prev aria-label="Previous image">‹</button>
          <button class="product__arrow product__arrow--next" type="button" data-next aria-label="Next image">›</button>
          <div class="product__dots" data-dots>
            {images.map((img, i) => (
              <button
                class="product__dot"
                data-dot={i}
                aria-label={`Go to image ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>
        <div class="product__thumbs">
          {images.map((img, i) => (
            <button
              class={`product__thumb${i === 0 ? " is-active" : ""}`}
              data-thumb={i}
              aria-label={img.alt}
            >
              <img src={img.src} alt="" />
            </button>
          ))}
        </div>
      </div>

      <!-- Info -->
      <div class="product__info">
        <p class="product__type">Hand rolled · Small batches</p>
        <h1 class="product__name">Incense Pellets 香丸</h1>
        <p class="product__notes">Xiang Wan · For electric warmers</p>
        <p class="product__desc">
          Hand-rolled incense pellets made from ground botanicals and resins — no charcoal, no synthetic perfume oils. Seven formulas, each made in small batches and refined by hand since early October.
        </p>

        <div class="product__meta">
          <div class="product__meta-item">
            <span class="product__meta-label">Formulas</span>
            <span class="product__meta-value">7 — traditional &amp; original</span>
          </div>
          <div class="product__meta-item">
            <span class="product__meta-label">For use with</span>
            <span class="product__meta-value">Electric incense warmer with temperature control</span>
          </div>
          <div class="product__meta-item">
            <span class="product__meta-label">Heating</span>
            <span class="product__meta-value">Start 100–120&deg;C · rise to 180–200&deg;C</span>
          </div>
        </div>

        <a href="/contact" class="product__cta">Enquire about this pellet</a>
        <p class="product__cta-note">Made to order in small batches — reach out for availability and current formulas.</p>

        <details class="product__accordion">
          <summary class="product__accordion-title">Why I Made This</summary>
          <div class="product__accordion-body">
            <p>Every pellet is hand-rolled from ground botanicals and resins — no charcoal, no synthetic perfume oils. Work on the samples began in early October, with constant re-blending and testing since. A formula is never finished, only refined.</p>
          </div>
        </details>
        <details class="product__accordion">
          <summary class="product__accordion-title">How to heat</summary>
          <div class="product__accordion-body">
            <p>Place on an electric warmer at 100–120&deg;C and let it bloom. As the aroma fades, raise the temperature gradually toward 180–200&deg;C — every warmer differs, so treat these as reference points. The top, middle, and base notes unfold at different stages; a session can last ten-plus hours. Two pellets at once for a stronger presence; break and flatten for a lighter one. A thousand noses, a thousand preferences.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Formulas -->
  <section class="formulas">
    <div class="container">
      <h2 class="formulas__title">The Formulas</h2>
      <p class="formulas__intro">Seven blends — some faithful to classical recipes, others original creations. The pellet size was made smaller after the first batch, listening to your feedback.</p>
      <div class="formulas__grid">
        {formulas.map((f) => (
          <article class="formula-card">
            <div class="formula-card__head">
              <h3 class="formula-card__name">{f.name_cn} · {f.name_en}</h3>
              <span class="formula-card__tag">{f.note}</span>
            </div>
            <p class="formula-card__desc">{f.desc}</p>
            <p class="formula-card__source">{f.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="story">
    <div class="container">
      <div class="story__inner">
        <h2 class="story__title">Hand Rolled. Small Batches. Nothing Hidden.</h2>
        <div class="story__body">
          <p>These pellets began as samples in early October — re-blended, re-tested, refined by hand. Incense is not the main work here, so only a few formulas exist, and each one earns its place.</p>
          <p><strong>Qing Lin Sui</strong> is new, with a striking coolness. <strong>Spring Moon Butterfly</strong> and <strong>Han Jianning Palace Incense</strong> follow their classical formulas closely. <strong>Wild Orchid of the Wilderness</strong> is an original creation; <strong>Princess Shouyang Plum Blossom</strong> and <strong>Xun Ling's Ten-Mile Fragrance</strong> honor the originals. <strong>Lili Marleen</strong> is my own blend, dedicated to Marlene Dietrich — a legend impossible to copy.</p>
          <p>The pellets were resized smaller after the first batch — your feedback, honored. They pair best with a temperature-controlled electric warmer.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product {
    padding: 48px 0 64px;
  }

  .product__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .product__gallery {
    position: sticky;
    top: 96px;
  }

  .product__main-image {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .product__main-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .product__main-image img.is-active {
    opacity: 1;
  }

  .product__carousel {
    position: relative;
  }

  .product__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    z-index: 2;
  }

  .product__arrow:hover {
    background: rgba(0, 0, 0, 0.45);
  }

  .product__arrow--prev {
    left: 14px;
  }

  .product__arrow--next {
    right: 14px;
  }

  .product__dots {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
    z-index: 2;
  }

  .product__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .product__dot.is-active {
    background: #fff;
    transform: scale(1.25);
  }

  .product__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
  }

  .product__thumb {
    width: 72px;
    height: 90px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
    padding: 0;
  }

  .product__thumb.is-active {
    border-color: var(--color-accent);
  }

  .product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .product__type {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .product__name {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.15;
  }

  .product__notes {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .product__desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .product__meta {
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product__meta-item {
    display: flex;
    gap: 12px;
    font-size: 13px;
  }

  .product__meta-label {
    flex-shrink: 0;
    width: 110px;
    color: var(--color-text-tertiary);
  }

  .product__meta-value {
    color: var(--color-text);
  }

  .product__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    background: var(--color-accent);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background 0.25s var(--ease-out);
    margin-top: 8px;
  }

  .product__cta:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }

  .product__cta-note {
    font-size: 12px;
    color: var(--color-text-tertiary);
    margin-top: -6px;
  }

  .product__accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .product__accordion:first-of-type {
    border-top: 1px solid var(--color-border);
  }

  .product__accordion-title {
    padding: 16px 4px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .product__accordion-title::-webkit-details-marker {
    display: none;
  }

  .product__accordion-title::after {
    content: "+";
    font-size: 18px;
    color: var(--color-accent);
    transition: transform 0.25s var(--ease-out);
  }

  .product__accordion[open] .product__accordion-title::after {
    transform: rotate(45deg);
  }

  .product__accordion-body {
    padding: 0 4px 16px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* ---- Formulas ---- */
  .formulas {
    padding: 64px 0;
  }

  .formulas__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 12px;
  }

  .formulas__intro {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-bottom: 32px;
  }

  .formulas__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .formula-card {
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .formula-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .formula-card__name {
    font-size: 16px;
  }

  .formula-card__tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 3px 10px;
    white-space: nowrap;
  }

  .formula-card__desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 10px;
  }

  .formula-card__source {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  /* ---- Story ---- */
  .story {
    padding: 64px 0 96px;
    background: var(--color-surface-subtle);
  }

  .story__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .story__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 20px;
    text-align: center;
  }

  .story__body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .story__body p {
    margin-bottom: 14px;
  }

  .story__body strong {
    color: var(--color-text);
    font-weight: 550;
  }

  @media (max-width: 900px) {
    .product__layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .product__gallery {
      position: static;
    }

    .formulas__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (() => {
    const gallery = document.querySelector("[data-gallery]");
    if (!gallery) return;

    const slides = [...gallery.querySelectorAll("[data-slide]")];
    const thumbs = [...gallery.querySelectorAll("[data-thumb]")];
    const dots = [...gallery.querySelectorAll("[data-dot]")];
    const prevBtn = gallery.querySelector("[data-prev]");
    const nextBtn = gallery.querySelector("[data-next]");
    const total = slides.length;
    let current = 0;
    let timer = null;

    function goTo(index) {
      current = (index + total) % total;
      slides.forEach((s, i) => s.classList.toggle("is-active", i === current));
      thumbs.forEach((t, i) => t.classList.toggle("is-active", i === current));
      dots.forEach((d, i) => d.classList.toggle("is-active", i === current));
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    function restart() {
      if (timer) clearInterval(timer);
      timer = setInterval(next, 5000);
    }

    // Auto-advance every 5s
    restart();

    // Pause on hover / touch
    gallery.addEventListener("mouseenter", () => {
      if (timer) clearInterval(timer);
    });
    gallery.addEventListener("mouseleave", restart);

    // Controls
    thumbs.forEach((t, i) => t.addEventListener("click", () => { goTo(i); restart(); }));
    dots.forEach((d, i) => d.addEventListener("click", () => { goTo(i); restart(); }));
    prevBtn?.addEventListener("click", () => { prev(); restart(); });
    nextBtn?.addEventListener("click", () => { next(); restart(); });

    // Keyboard
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { prev(); restart(); }
      if (e.key === "ArrowRight") { next(); restart(); }
    });
  })();
</script>
