---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    // Related: posts sharing tags, excluding self, top 3 by tag overlap
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => {
        const overlap = (p.data.tags ?? []).filter((t) => (post.data.tags ?? []).includes(t)).length;
        return { post: p, overlap };
      })
      .sort((a, b) => b.overlap - a.overlap)
      .slice(0, 3)
      .map((r) => r.post);
    return {
      params: { slug: post.id },
      props: { post, related },
    };
  });
}

type Props = CollectionEntry<'blog'> & { related: CollectionEntry<'blog'>[] };

const { post, related } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} related={related}>
  <Content />
</BlogPost>
